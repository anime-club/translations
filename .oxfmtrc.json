{
  "ignorePatterns": ["**/*.js", "**/*.jsx"],
  "arrowParens": "always",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": false,
  "useTabs": false,
  "bracketSpacing": true,
  "sortImports": {
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"], "unknown"],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true
  }
}
